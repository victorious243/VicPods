PORT=3000
MONGO_URI=mongodb+srv://username:<db_password>@cluster.mongodb.net/vicpods?retryWrites=true&w=majority
SESSION_SECRET=change_this_to_a_random_32_plus_char_secret
AI_PROVIDER=openai
OPENAI_API_KEY=
APP_URL=http://localhost:3000

# Storage
# Local development can keep using local_public. Production should use Cloudflare R2.
STORAGE_PROVIDER=local_public

# Cloudflare R2 / S3-compatible storage.
# Never commit real token values here. Use the jurisdiction-specific endpoint from Cloudflare when required.
R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<cloudflare-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<cloudflare-r2-secret-access-key>
R2_BUCKET=vicpods-media
R2_REGION=auto
R2_PUBLIC_BASE_URL=https://media.vicpods.com

LEGAL_ENTITY_NAME=VicPods Ltd
LEGAL_TRADING_NAME=VicPods
LEGAL_COUNTRY=Ireland
LEGAL_ADDRESS=Street Line 1|City|Postcode|Ireland
PRIVACY_CONTACT_EMAIL=privacy@vicpods.com
SUPPORT_CONTACT_EMAIL=hello@vicpods.com
LEGAL_CONTACT_EMAIL=legal@vicpods.com
NEW_USER_MFA_DAYS=14
GOOGLE_OIDC_ISSUER_URL=https://accounts.google.com
GOOGLE_OIDC_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com
# Optional for public PKCE Google clients. Leave blank when the OAuth client does not have a secret.
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_OIDC_SCOPES=openid email profile
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM="VicPods <sender@verified-domain-you-own.com>"
EMAIL_TEST_TO=you@example.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BILLING_CURRENCY=eur
# Optional fallback Price IDs when a plan does not use a Payment Link.
STRIPE_PRICE_WORKSPACE_CREATOR=
STRIPE_PRICE_WORKSPACE_GROWTH=
STRIPE_PRICE_WORKSPACE_STUDIO=
STRIPE_PRICE_HOSTING_STARTER=
STRIPE_PRICE_HOSTING_GROWTH=
STRIPE_PRICE_HOSTING_STUDIO=
# Optional Stripe-hosted Payment Links. When omitted, VicPods uses server-created Checkout Sessions.
STRIPE_PAYMENT_LINK_WORKSPACE_CREATOR=
STRIPE_PAYMENT_LINK_WORKSPACE_GROWTH=
STRIPE_PAYMENT_LINK_WORKSPACE_STUDIO=
STRIPE_PAYMENT_LINK_HOSTING_STARTER=
STRIPE_PAYMENT_LINK_HOSTING_GROWTH=
STRIPE_PAYMENT_LINK_HOSTING_STUDIO=
BILLING_CURRENCY_SYMBOL=€
BILLING_INTERVAL_LABEL=/mo
BILLING_PAYMENT_GRACE_DAYS=7
BILLING_PRICE_WORKSPACE_FREE=0
BILLING_PRICE_WORKSPACE_CREATOR=19
BILLING_PRICE_WORKSPACE_GROWTH=39
BILLING_PRICE_WORKSPACE_STUDIO=89
BILLING_PRICE_HOSTING_NONE=0
BILLING_PRICE_HOSTING_STARTER=9
BILLING_PRICE_HOSTING_GROWTH=19
BILLING_PRICE_HOSTING_STUDIO=49
