<div class="help-page-shell landing-page-shell">
  <section class="landing-hero card" data-help-reveal>
    <div class="landing-copy">
      <span class="landing-kicker"><%= t('page.landing.kicker', 'For podcasters who hate blank pages') %></span>
      <h1>AI podcast planning and launch prep for creators.</h1>
      <p class="landing-lead">VicPods helps podcasters turn rough ideas into structured episodes, show notes, launch assets, and exportable episode briefs before recording starts.</p>

      <div class="inline-actions landing-actions">
        <% if (currentUser) { %>
          <a href="/create/single" class="btn btn-primary"><%= t('page.landing.cta.primary.user', 'New Episode') %></a>
          <a href="/studio" class="btn btn-secondary"><%= t('page.landing.cta.secondary.user', 'Go to Studio') %></a>
        <% } else { %>
          <a href="#idea-to-episode-generator" class="btn btn-primary"><%= t('page.landing.cta.primary.guest', 'Generate Episode') %></a>
          <a href="/examples" class="btn btn-secondary">See sample outputs</a>
        <% } %>
        <% if (currentUser) { %>
          <a href="/help" class="btn btn-ghost"><%= t('page.landing.cta.help', 'See how it works') %></a>
        <% } else { %>
          <a href="/auth/login" class="btn btn-ghost"><%= t('page.landing.cta.help', 'Sign in') %></a>
        <% } %>
      </div>

      <p class="mini-note">Free preview. No card. No long onboarding. Create an account only when you want to save the result, generate the full draft, or unlock the full Launch Pack.</p>

      <div class="landing-proof">
        <span class="mini-label"><%= t('page.landing.proof.one', 'Title + hook in seconds') %></span>
        <span class="mini-label"><%= t('page.landing.proof.two', 'Structured outline') %></span>
        <span class="mini-label"><%= t('page.landing.proof.three', 'Launch Pack preview') %></span>
      </div>
    </div>

    <div class="landing-visual">
      <div class="landing-orb landing-orb-back"></div>
      <div class="landing-orb landing-orb-front"></div>
      <div
        class="landing-model-shell hero-model-shell"
        data-lazy-model
        data-model-src="/models/vicpods-landing-mic.glb"
        data-model-auto-rotate="true"
        data-model-rotation-per-second="10deg"
        data-model-min-width="920"
        data-model-root-margin="160px"
        data-model-aria-label="VicPods studio microphone"
      >
        <div class="hero-model-fallback" data-model-fallback aria-hidden="true">
          <span class="hero-model-fallback-ring"></span>
          <img
            src="/images/logo/vicpods-icon-circle-dark.svg"
            alt=""
            class="hero-model-fallback-logo hero-model-fallback-logo-dark"
            width="164"
            height="164"
          />
          <img
            src="/images/logo/vicpods-icon-circle-light.svg"
            alt=""
            class="hero-model-fallback-logo hero-model-fallback-logo-light"
            width="164"
            height="164"
          />
        </div>
      </div>
      <div class="landing-wave-ring landing-wave-ring-a"></div>
      <div class="landing-wave-ring landing-wave-ring-b"></div>
      <div class="landing-status-chip"><%= t('page.landing.status', 'Free live preview') %></div>
    </div>
  </section>

  <section class="landing-momentum-strip" data-help-reveal>
    <% (landingMomentumCards || []).forEach((item, index) => { %>
      <article class="card landing-card landing-momentum-card">
        <div class="landing-momentum-meta">
          <span class="landing-card-index"><%= String(index + 1).padStart(2, '0') %></span>
          <span class="landing-momentum-tag"><%= item.eyebrow %></span>
        </div>
        <h3><%= item.title %></h3>
        <p><%= item.body %></p>
      </article>
    <% }) %>
  </section>

  <section class="card landing-steps landing-steps-shell" data-help-reveal>
    <div class="section-head">
      <div>
        <span class="landing-kicker">AI podcast planning workspace</span>
        <h2>Plan the episode, package the launch, and keep the whole show organized.</h2>
        <p class="mini-note">
          VicPods is an AI-powered podcast planning and launch-prep workspace for creators who want structured episodes, show notes, launch assets, and exportable episode briefs before they record.
        </p>
      </div>
      <a href="/guides" class="btn btn-ghost">Read podcast guides</a>
    </div>

    <div class="landing-step-row">
      <article>
        <span class="landing-step-label">Studio</span>
        <p>Track series, standalone episodes, Ready and Served drafts, Pantry ideas, and AI usage from one dashboard.</p>
      </article>
      <article>
        <span class="landing-step-label">Kitchen</span>
        <p>Build podcast series around themes, episodes, continuity, audience goals, and recording-ready briefs.</p>
      </article>
      <article>
        <span class="landing-step-label">Pantry</span>
        <p>Save raw hooks, notes, and topic ideas so strong concepts do not disappear before recording day.</p>
      </article>
      <article>
        <span class="landing-step-label">Chef AI</span>
        <p>Generate outlines, hooks, show notes packs, launch packs, tone improvements, and exportable episode briefs.</p>
      </article>
    </div>
  </section>

  <section class="card landing-generator-section" id="idea-to-episode-generator" data-help-reveal>
    <div class="landing-generator-head">
      <span class="landing-kicker">See the episode before you commit</span>
      <h2>Paste a rough idea. Get the title, hook, outline, and next step.</h2>
      <p class="landing-generator-copy">
        This is the fastest way to see whether VicPods fits your workflow. No login needed for the preview.
      </p>
    </div>

    <form
      class="landing-generator-form"
      action="/api/public/generate"
      method="post"
      data-public-generator-form
    >
      <label class="landing-generator-label" for="landingIdeaInput">Type your podcast idea</label>
      <textarea
        id="landingIdeaInput"
        name="idea"
        class="landing-generator-textarea"
        placeholder="Example: A solo episode about why most podcasters quit before episode 20"
        rows="5"
        maxlength="900"
        data-public-generator-input
      ></textarea>

      <div class="landing-generator-actions">
        <div class="landing-generator-meta">
          <span class="mini-label">Free preview</span>
          <p>Paste the idea, judge the structure, and sign up only if you want to keep building inside VicPods.</p>
        </div>

        <button type="submit" class="btn btn-primary landing-generator-submit" data-public-generator-submit>
          Generate Episode
        </button>
      </div>

      <p
        class="landing-generator-status"
        data-public-generator-status
        hidden
        role="status"
        aria-live="polite"
      ></p>
      <p class="landing-generator-error" data-public-generator-error hidden></p>
    </form>

    <%- include('../partials/landing-episode-preview', {
      unlockHref: currentUser
        ? ((effectivePlan === 'pro' || effectivePlan === 'premium') ? '/studio' : '/settings?section=billing')
        : '/auth/register',
      unlockLabel: currentUser
        ? ((effectivePlan === 'pro' || effectivePlan === 'premium') ? 'Open Studio' : 'Unlock full launch pack')
        : 'Unlock full launch pack',
      fullLaunchPackPreview: Boolean(currentUser && (effectivePlan === 'pro' || effectivePlan === 'premium')),
    }) %>
  </section>

  <section class="card landing-pricing-shell" id="vicpods-pricing" data-help-reveal>
    <div class="section-head landing-pricing-head">
      <div>
        <span class="landing-kicker">Start free. Upgrade when it saves you time.</span>
        <h3>See the result first. Pay only when you want the full draft and launch workflow.</h3>
        <p class="landing-pricing-copy">
          VicPods is designed to prove value early. Generate the preview, judge the structure, then upgrade only when you want deeper drafting, launch assets, and faster publishing momentum.
        </p>
      </div>
      <div class="landing-pricing-badges">
        <span class="mini-label">No login needed for the public generator</span>
        <span class="mini-label">Founding pricing through <%= pricing.foundingDeadlineLabel %></span>
      </div>
    </div>

    <div class="card-grid premium-plan-grid landing-plan-grid">
      <% publicPricingPlans.forEach((plan) => { %>
        <article class="card premium-plan-card landing-plan-card <%= plan.key === 'pro' ? 'premium-plan-card-featured' : '' %>">
          <div class="premium-plan-card-top">
            <div>
              <span class="mini-label"><%= plan.eyebrow %></span>
              <h4><%= plan.title %></h4>
            </div>
            <% if (plan.key === 'pro') { %>
              <span class="mini-label">Best unlock</span>
            <% } %>
          </div>
          <p class="premium-price"><%= plan.price %></p>
          <p class="premium-plan-tagline"><%= plan.summary %></p>
          <ul class="premium-plan-feature-list">
            <% plan.features.forEach((feature) => { %>
              <li>
                <span class="premium-feature-dot" aria-hidden="true"></span>
                <span><%= feature %></span>
              </li>
            <% }) %>
          </ul>
          <p class="mini-note"><%= plan.note %></p>
        </article>
      <% }) %>
    </div>

    <div class="inline-actions landing-pricing-actions">
      <a href="#idea-to-episode-generator" class="btn btn-primary">Generate Episode</a>
      <% if (currentUser) { %>
        <a href="/settings?section=billing" class="btn btn-secondary">Open Billing</a>
      <% } else { %>
        <a href="/auth/register" class="btn btn-secondary">Create free account to keep building</a>
      <% } %>
    </div>
  </section>

  <section class="landing-proof-shell landing-proof-studio" data-help-reveal>
    <div class="landing-proof-studio-head">
      <div>
        <span class="landing-kicker">After the preview</span>
        <h3>Why podcasters sign up after one useful preview</h3>
        <p>The first win is clarity before recording.</p>
      </div>
      <a href="/examples" class="btn btn-ghost">Open example library</a>
    </div>

    <div class="landing-proof-console">
      <article class="landing-proof-record">
        <div class="landing-record-art" aria-hidden="true">
          <span></span>
          <strong>REC</strong>
        </div>
        <div class="landing-record-copy">
          <span class="mini-label">Recording brief</span>
          <h4>Know what the episode is before the mic turns on.</h4>
          <p>VicPods gives the title, hook, outline, CTA, and launch direction first, so the account decision happens after the creator sees a real episode shape.</p>
          <div class="landing-proof-cues">
            <span>Hook</span>
            <span>Outline</span>
            <span>CTA</span>
            <span>Launch angle</span>
          </div>
        </div>
      </article>

      <article class="landing-proof-runbook">
        <div class="landing-runbook-head">
          <span class="mini-label">Run of show</span>
          <strong>Preview becomes prep</strong>
        </div>
        <ol>
          <li><span>00:00</span><strong>Cold open</strong><em>Start with the listener problem, not filler.</em></li>
          <li><span>02:30</span><strong>Core arc</strong><em>Move through the key beats before recording day.</em></li>
          <li><span>18:00</span><strong>Launch close</strong><em>End with a usable CTA and show-note direction.</em></li>
        </ol>
      </article>

      <article class="landing-proof-folder">
        <span class="mini-label">Launch folder</span>
        <h4>Assets that feel like production output, not prompt output.</h4>
        <div class="landing-folder-stack">
          <span>Title options</span>
          <span>Short description</span>
          <span>Show notes</span>
          <span>Social captions</span>
        </div>
      </article>
    </div>
  </section>

  <section class="landing-examples-shell landing-examples-studio" data-help-reveal>
    <div class="landing-proof-studio-head">
      <div>
        <span class="landing-kicker">Real podcast formats</span>
        <h3>Sample outputs built around episodes people actually publish</h3>
        <p>Each example shows the recording angle, the running order, and the launch assets a creator would use after the draft.</p>
      </div>
      <a href="/examples" class="btn btn-ghost">View all examples</a>
    </div>

    <div class="landing-format-board">
      <% (featuredExamples || []).forEach((example, index) => { %>
        <article class="landing-format-card" id="<%= example.slug %>">
          <div class="landing-format-cover" aria-hidden="true">
            <span class="landing-format-disc"></span>
            <strong><%= String(index + 1).padStart(2, '0') %></strong>
          </div>
          <div class="landing-format-main">
            <div class="landing-format-topline">
              <span class="mini-label"><%= example.styleLabel %></span>
              <% if (example.templateKey) { %>
                <span class="landing-format-template"><%= example.templateKey.replace(/_/g, ' ') %></span>
              <% } %>
            </div>
            <h4><%= example.title %></h4>
            <p><%= example.hook %></p>
            <div class="landing-format-rundown">
              <% (example.outline || []).slice(0, 4).forEach((item, itemIndex) => { %>
                <span><strong><%= String(itemIndex + 1).padStart(2, '0') %></strong><%= item %></span>
              <% }) %>
            </div>
            <div class="landing-format-launch">
              <strong>Launch Pack preview</strong>
              <p><%= example.launchPack?.description %></p>
              <div>
                <% (example.launchPack?.titles || []).slice(0, 2).forEach((titleOption) => { %>
                  <span><%= titleOption %></span>
                <% }) %>
              </div>
            </div>
            <div class="inline-actions">
              <a href="/?idea=<%= encodeURIComponent(example.ideaSeed || example.title) %>#idea-to-episode-generator" class="btn btn-primary">Use this angle</a>
              <a href="/examples#<%= example.slug %>" class="btn btn-ghost">Open example</a>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

  <section class="landing-workflow-studio" data-help-reveal>
    <div class="landing-proof-studio-head">
      <div>
        <span class="landing-kicker">Creator workflow</span>
        <h3>From rough idea to recording desk</h3>
        <p>VicPods is strongest when the creator can see the work they would actually do next.</p>
      </div>
      <a href="/about" class="btn btn-ghost"><%= t('page.landing.steps.link', 'About VicPods') %></a>
    </div>

    <div class="landing-workflow-timeline">
      <article>
        <span>01</span>
        <h4>Paste the topic</h4>
        <p>Use the idea already sitting in notes, voice memos, or the content calendar.</p>
      </article>
      <article>
        <span>02</span>
        <h4>Check the episode shape</h4>
        <p>Review the hook, outline, listener promise, and closing direction before committing.</p>
      </article>
      <article>
        <span>03</span>
        <h4>Build the recording brief</h4>
        <p>Turn the preview into structure, host prompts, prep notes, and a clear run of show.</p>
      </article>
      <article>
        <span>04</span>
        <h4>Package the launch</h4>
        <p>Create titles, description, show notes, captions, and a stronger CTA for release day.</p>
      </article>
    </div>
  </section>
</div>

<script src="/javascripts/help-center.js" defer></script>
<script src="/javascripts/landing-generator.js" defer></script>
<script src="/javascripts/lazy-hero-model.js" defer></script>
