<div class="help-page-shell landing-page-shell">
  <section class="landing-hero card" data-help-reveal>
    <div class="landing-copy">
      <span class="landing-kicker"><%= t('page.landing.kicker', 'For podcasters who hate blank pages') %></span>
      <h1><%= t('page.landing.hero.title', 'Turn one podcast idea into a ready-to-record episode in minutes.') %></h1>
      <p class="landing-lead"><%= t('page.landing.hero.body', 'Paste the idea you were planning to record next. VicPods gives you a stronger title, sharper hook, structured outline, and launch-ready direction before you touch your notes.') %></p>

      <div class="inline-actions landing-actions">
        <% if (currentUser) { %>
          <a href="/create/single" class="btn btn-primary"><%= t('page.landing.cta.primary.user', 'New Episode') %></a>
          <a href="/studio" class="btn btn-secondary"><%= t('page.landing.cta.secondary.user', 'Go to Studio') %></a>
        <% } else { %>
          <a href="#idea-to-episode-generator" class="btn btn-primary"><%= t('page.landing.cta.primary.guest', 'Generate Episode') %></a>
          <a href="/examples" class="btn btn-secondary">See sample outputs</a>
        <% } %>
        <% if (currentUser) { %>
          <a href="/help" class="btn btn-ghost"><%= t('page.landing.cta.help', 'See how it works') %></a>
        <% } else { %>
          <a href="/auth/login" class="btn btn-ghost"><%= t('page.landing.cta.help', 'Sign in') %></a>
        <% } %>
      </div>

      <p class="mini-note">Free preview. No card. No long onboarding. Create an account only when you want to save the result, generate the full draft, or unlock the full Launch Pack.</p>

      <div class="landing-proof">
        <span class="mini-label"><%= t('page.landing.proof.one', 'Title + hook in seconds') %></span>
        <span class="mini-label"><%= t('page.landing.proof.two', 'Structured outline') %></span>
        <span class="mini-label"><%= t('page.landing.proof.three', 'Launch Pack preview') %></span>
      </div>
    </div>

    <div class="landing-visual">
      <div class="landing-orb landing-orb-back"></div>
      <div class="landing-orb landing-orb-front"></div>
      <div class="landing-model-shell">
        <model-viewer
          src="/models/vicpods-landing-mic.glb"
          camera-controls
          auto-rotate
          rotation-per-second="10deg"
          disable-pan
          shadow-intensity="1"
          exposure="1.05"
          environment-image="neutral"
          interaction-prompt="none"
          touch-action="pan-y"
          style="width: 100%; height: 100%; background: transparent;"
        ></model-viewer>
      </div>
      <div class="landing-wave-ring landing-wave-ring-a"></div>
      <div class="landing-wave-ring landing-wave-ring-b"></div>
      <div class="landing-status-chip"><%= t('page.landing.status', 'Free live preview') %></div>
    </div>
  </section>

  <section class="landing-momentum-strip" data-help-reveal>
    <% (landingMomentumCards || []).forEach((item, index) => { %>
      <article class="card landing-card landing-momentum-card">
        <span class="landing-card-index"><%= String(index + 1).padStart(2, '0') %></span>
        <h3><%= item.title %></h3>
        <p><%= item.body %></p>
        <span class="landing-momentum-tag"><%= item.eyebrow %></span>
      </article>
    <% }) %>
  </section>

  <section class="card landing-generator-section" id="idea-to-episode-generator" data-help-reveal>
    <div class="landing-generator-head">
      <span class="landing-kicker">See the episode before you commit</span>
      <h2>Paste a rough idea. Get the title, hook, outline, and next step.</h2>
      <p class="landing-generator-copy">
        This is the fastest way to see whether VicPods fits your workflow. No login needed for the preview.
      </p>
    </div>

    <form
      class="landing-generator-form"
      action="/api/public/generate"
      method="post"
      data-public-generator-form
    >
      <label class="landing-generator-label" for="landingIdeaInput">Type your podcast idea</label>
      <textarea
        id="landingIdeaInput"
        name="idea"
        class="landing-generator-textarea"
        placeholder="Example: A solo episode about why most podcasters quit before episode 20"
        rows="5"
        maxlength="900"
        data-public-generator-input
      ></textarea>

      <div class="landing-generator-actions">
        <div class="landing-generator-meta">
          <span class="mini-label">Free preview</span>
          <p>Paste the idea, judge the structure, and sign up only if you want to keep building inside VicPods.</p>
        </div>

        <button type="submit" class="btn btn-primary landing-generator-submit" data-public-generator-submit>
          Generate Episode
        </button>
      </div>

      <p
        class="landing-generator-status"
        data-public-generator-status
        hidden
        role="status"
        aria-live="polite"
      ></p>
      <p class="landing-generator-error" data-public-generator-error hidden></p>
    </form>

    <%- include('../partials/landing-episode-preview', {
      unlockHref: currentUser
        ? ((effectivePlan === 'pro' || effectivePlan === 'premium') ? '/studio' : '/settings?section=billing')
        : '/auth/register',
      unlockLabel: currentUser
        ? ((effectivePlan === 'pro' || effectivePlan === 'premium') ? 'Open Studio' : 'Unlock full launch pack')
        : 'Unlock full launch pack',
      fullLaunchPackPreview: Boolean(currentUser && (effectivePlan === 'pro' || effectivePlan === 'premium')),
    }) %>
  </section>

  <section class="card landing-pricing-shell" id="vicpods-pricing" data-help-reveal>
    <div class="section-head landing-pricing-head">
      <div>
        <span class="landing-kicker">Start free. Upgrade when it saves you time.</span>
        <h3>See the result first. Pay only when you want the full draft and launch workflow.</h3>
        <p class="landing-pricing-copy">
          VicPods is designed to prove value early. Generate the preview, judge the structure, then upgrade only when you want deeper drafting, launch assets, and faster publishing momentum.
        </p>
      </div>
      <div class="landing-pricing-badges">
        <span class="mini-label">No login needed for the public generator</span>
        <span class="mini-label">Founding pricing through <%= pricing.foundingDeadlineLabel %></span>
      </div>
    </div>

    <div class="card-grid premium-plan-grid landing-plan-grid">
      <% publicPricingPlans.forEach((plan) => { %>
        <article class="card premium-plan-card landing-plan-card <%= plan.key === 'pro' ? 'premium-plan-card-featured' : '' %>">
          <div class="premium-plan-card-top">
            <div>
              <span class="mini-label"><%= plan.eyebrow %></span>
              <h4><%= plan.title %></h4>
            </div>
            <% if (plan.key === 'pro') { %>
              <span class="mini-label">Best unlock</span>
            <% } %>
          </div>
          <p class="premium-price"><%= plan.price %></p>
          <p class="premium-plan-tagline"><%= plan.summary %></p>
          <ul class="premium-plan-feature-list">
            <% plan.features.forEach((feature) => { %>
              <li>
                <span class="premium-feature-dot" aria-hidden="true"></span>
                <span><%= feature %></span>
              </li>
            <% }) %>
          </ul>
          <p class="mini-note"><%= plan.note %></p>
        </article>
      <% }) %>
    </div>

    <div class="inline-actions landing-pricing-actions">
      <a href="#idea-to-episode-generator" class="btn btn-primary">Generate Episode</a>
      <% if (currentUser) { %>
        <a href="/settings?section=billing" class="btn btn-secondary">Open Billing</a>
      <% } else { %>
        <a href="/auth/register" class="btn btn-secondary">Create free account to keep building</a>
      <% } %>
    </div>
  </section>

  <section class="landing-proof-shell" data-help-reveal>
    <div class="section-head">
      <div>
        <h3>Why podcasters sign up after one useful preview</h3>
        <p class="mini-note">The first win is clarity before recording.</p>
      </div>
      <a href="/examples" class="btn btn-ghost">Open example library</a>
    </div>
    <%- include('../partials/proof-snippet-grid', { proofSnippets: landingProofSnippets }) %>
  </section>

  <section class="landing-examples-shell" data-help-reveal>
    <div class="section-head">
      <div>
        <h3>Sample outputs built for real podcast formats</h3>
        <p class="mini-note">See the shape of the episode and the launch angle before you commit to the workflow.</p>
      </div>
      <a href="/examples" class="btn btn-ghost">View all examples</a>
    </div>
    <%- include('../partials/example-preview-grid', { examples: featuredExamples, gridClass: 'example-preview-grid-compact' }) %>
  </section>

  <section class="help-story-stack landing-story-stack">
    <article class="card help-story-section" data-help-reveal>
      <div class="help-story-aside">
        <span class="help-story-index">01</span>
        <h3><%= t('page.landing.card.single.title', 'Get the first useful episode fast') %></h3>
      </div>
      <div class="help-story-content">
        <p class="help-story-lead"><%= t('page.landing.card.single.body', 'Choose the podcast style, add the topic, and let VicPods shape the title, hook, structure, and launch direction in one pass.') %></p>
        <div class="inline-actions">
          <% if (currentUser) { %>
            <a href="/create/single" class="btn btn-ghost"><%= t('page.landing.card.single.cta', 'Open single flow') %></a>
          <% } else { %>
            <a href="#idea-to-episode-generator" class="btn btn-ghost"><%= t('page.landing.card.single.cta', 'Generate episode') %></a>
          <% } %>
        </div>
      </div>
    </article>

    <article class="card help-story-section" data-help-reveal>
      <div class="help-story-aside">
        <span class="help-story-index">02</span>
        <h3><%= t('page.landing.card.series.title', 'Keep a stronger weekly publishing rhythm') %></h3>
      </div>
      <div class="help-story-content">
        <p class="help-story-lead"><%= t('page.landing.card.series.body', 'Plan season goals, recurring themes, continuity rules, and episode arcs so each recording starts with a clearer brief instead of last-minute prep.') %></p>
        <div class="inline-actions">
          <% if (currentUser) { %>
            <a href="/create/series" class="btn btn-ghost"><%= t('page.landing.card.series.cta', 'Open series flow') %></a>
          <% } else { %>
            <a href="/examples" class="btn btn-ghost"><%= t('page.landing.card.series.cta', 'View sample outputs') %></a>
          <% } %>
        </div>
      </div>
    </article>

    <article class="card help-story-section" data-help-reveal>
      <div class="help-story-aside">
        <span class="help-story-index">03</span>
        <h3><%= t('page.landing.card.guide.title', 'Turn the draft into launch-ready assets') %></h3>
      </div>
      <div class="help-story-content">
        <p class="help-story-lead"><%= t('page.landing.card.guide.body', 'Use Studio, Workspace, Pantry, and Launch Pack tools together to move from rough idea to publish-ready prep without losing the next step.') %></p>
        <div class="inline-actions">
          <a href="/help" class="btn btn-ghost"><%= t('page.landing.card.guide.cta', 'Open Help Center') %></a>
        </div>
      </div>
    </article>
  </section>

  <section class="card landing-steps landing-steps-shell" data-help-reveal>
    <div class="section-head">
      <h3><%= t('page.landing.steps.title', 'From rough idea to publishing momentum') %></h3>
      <a href="/about" class="btn btn-ghost"><%= t('page.landing.steps.link', 'About VicPods') %></a>
    </div>

    <div class="landing-step-row">
      <article>
        <span class="landing-step-label"><%= t('page.landing.steps.one.label', 'Idea') %></span>
        <p><%= t('page.landing.steps.one.body', 'Paste the topic you were already planning to record.') %></p>
      </article>
      <article>
        <span class="landing-step-label"><%= t('page.landing.steps.two.label', 'Preview') %></span>
        <p><%= t('page.landing.steps.two.body', 'Get the title, hook, outline, and next step before you commit.') %></p>
      </article>
      <article>
        <span class="landing-step-label"><%= t('page.landing.steps.three.label', 'Draft') %></span>
        <p><%= t('page.landing.steps.three.body', 'Unlock the full draft when you want to keep building inside Studio.') %></p>
      </article>
      <article>
        <span class="landing-step-label"><%= t('page.landing.steps.four.label', 'Launch') %></span>
        <p><%= t('page.landing.steps.four.body', 'Package notes, captions, and launch assets when the episode is ready to move.') %></p>
      </article>
    </div>
  </section>
</div>

<script src="/javascripts/help-center.js" defer></script>
<script src="/javascripts/landing-generator.js" defer></script>
<script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
