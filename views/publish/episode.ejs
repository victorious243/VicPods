<%
  const episodeMeta = [
    publishedEpisode.publishedAt ? new Date(publishedEpisode.publishedAt).toLocaleDateString() : '',
    publishedEpisode.durationLabel,
    publishedEpisode.explicit ? 'Explicit' : 'Clean',
    publishedEpisode.visibility !== 'public' ? 'Premium' : '',
  ].filter(Boolean);
  const formatChapterTime = (seconds) => {
    if (!Number.isFinite(seconds) || seconds < 0) {
      return '';
    }
    const total = Math.round(seconds);
    const hours = Math.floor(total / 3600);
    const minutes = Math.floor((total % 3600) / 60);
    const remainingSeconds = total % 60;
    if (hours > 0) {
      return `${hours}:${String(minutes).padStart(2, '0')}:${String(remainingSeconds).padStart(2, '0')}`;
    }
    return `${minutes}:${String(remainingSeconds).padStart(2, '0')}`;
  };
%>

<div class="published-podcast-page published-episode-page published-theme-<%= publishedEpisode.themeVariant || 'studio' %>">
  <section class="published-episode-stage">
    <div class="published-episode-art-panel">
      <div class="published-cover-frame">
        <img src="<%= publishedEpisode.coverImageUrl %>" alt="<%= publishedEpisode.showName %> cover art" />
      </div>
      <div class="published-record-shadow" aria-hidden="true"></div>
    </div>

    <article class="published-episode-copy">
      <span class="mini-label published-live-label"><%= publishedEpisode.heroLabel || 'Published with VicPods' %></span>
      <h1><%= publishedEpisode.title %></h1>
      <% if (publishedEpisode.heroTagline) { %>
        <p class="published-episode-summary"><%= publishedEpisode.heroTagline %></p>
      <% } %>
      <p class="published-episode-show">
        <a href="<%= publishedEpisode.showUrl %>"><%= publishedEpisode.showName %></a>
        <span>Hosted by <%= publishedEpisode.showAuthor %></span>
      </p>
      <p class="published-episode-summary"><%= publishedEpisode.summary %></p>

      <div class="published-meta-strip">
        <% episodeMeta.forEach((item) => { %>
          <span><%= item %></span>
        <% }) %>
      </div>

      <div class="inline-actions published-action-row">
        <a class="btn btn-primary" href="<%= publishedEpisode.showUrl %>">Show page</a>
        <a class="btn btn-secondary" href="<%= publishedEpisode.feedUrl %>">RSS Feed</a>
        <% if (publishedEpisode.showWebsiteUrl) { %>
          <a class="btn btn-ghost" href="<%= publishedEpisode.showWebsiteUrl %>" target="_blank" rel="noopener noreferrer">Website</a>
        <% } %>
        <% if (publishedEpisode.primaryCtaLabel && publishedEpisode.primaryCtaUrl) { %>
          <a class="btn btn-secondary" href="<%= publishedEpisode.primaryCtaUrl %>" target="_blank" rel="noopener noreferrer"><%= publishedEpisode.primaryCtaLabel %></a>
        <% } %>
      </div>

      <% if (publishedEpisode.featuredLabel || publishedEpisode.featuredText || publishedEpisode.hostIntro) { %>
        <div class="published-support-panel">
          <% if (publishedEpisode.featuredLabel) { %>
            <span class="mini-label"><%= publishedEpisode.featuredLabel %></span>
          <% } %>
          <% if (publishedEpisode.featuredText) { %>
            <p><%= publishedEpisode.featuredText %></p>
          <% } %>
          <% if (publishedEpisode.hostIntro) { %>
            <p class="mini-note"><%= publishedEpisode.hostIntro %></p>
          <% } %>
        </div>
      <% } %>
    </article>
  </section>

  <section class="published-episode-listening-console" data-podcast-player data-episode-id="<%= publishedEpisode.episodeId %>">
    <div class="published-console-copy">
      <span class="mini-label">Listen now</span>
      <strong><%= publishedEpisode.showName %></strong>
    </div>
    <div class="published-console-wave" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>
    <% if (publishedEpisode.audioUrl) { %>
      <audio controls preload="none" src="<%= publishedEpisode.audioUrl %>"></audio>
    <% } else { %>
      <p class="mini-note">Audio is being prepared.</p>
    <% } %>
  </section>

  <section class="published-episode-content-grid">
    <article class="published-episode-section published-notes-panel">
      <div class="section-head published-section-head">
        <div>
          <span class="mini-label">Episode notes</span>
          <h3>What this conversation is about</h3>
        </div>
        <a class="btn btn-ghost" href="<%= publishedEpisode.feedUrl %>">Open Feed XML</a>
      </div>
      <p><%= publishedEpisode.description %></p>
    </article>

    <aside class="published-show-card">
      <span class="mini-label">About the show</span>
      <strong><%= publishedEpisode.showName %></strong>
      <p><%= publishedEpisode.showDescription || 'This episode is published from a hosted VicPods show.' %></p>
      <div class="inline-actions">
        <a class="btn btn-secondary" href="<%= publishedEpisode.showUrl %>">More episodes</a>
        <% if (publishedEpisode.showWebsiteUrl) { %>
          <a class="btn btn-ghost" href="<%= publishedEpisode.showWebsiteUrl %>" target="_blank" rel="noopener noreferrer">Website</a>
        <% } %>
      </div>
    </aside>
  </section>

  <% if (publishedEpisode.outline.length) { %>
    <section class="published-episode-section published-rundown-panel">
      <div class="section-head published-section-head">
        <div>
          <span class="mini-label">Run of show</span>
          <h3>Episode structure</h3>
        </div>
        <span class="published-count-pill"><%= publishedEpisode.outline.length %> beats</span>
      </div>

      <div class="published-outline-flow">
        <% publishedEpisode.outline.forEach((item, index) => { %>
          <article class="published-outline-beat">
            <span class="published-outline-index"><%= String(index + 1).padStart(2, '0') %></span>
            <span class="published-outline-line" aria-hidden="true"></span>
            <p><%= item %></p>
          </article>
        <% }) %>
      </div>
    </section>
  <% } %>

  <% if (publishedEpisode.chapters && publishedEpisode.chapters.length) { %>
    <section class="published-episode-section published-rundown-panel">
      <div class="section-head published-section-head">
        <div>
          <span class="mini-label">Chapter markers</span>
          <h3>Jump through the episode</h3>
        </div>
        <span class="published-count-pill"><%= publishedEpisode.chapters.length %> markers</span>
      </div>

      <div class="published-outline-flow">
        <% publishedEpisode.chapters.forEach((chapter, index) => { %>
          <article class="published-outline-beat">
            <span class="published-outline-index"><%= formatChapterTime(chapter.startSeconds) || String(index + 1).padStart(2, '0') %></span>
            <span class="published-outline-line" aria-hidden="true"></span>
            <p><%= chapter.title %></p>
          </article>
        <% }) %>
      </div>
    </section>
  <% } %>

  <% if ((publishedEpisode.supportLinks || []).length) { %>
    <section class="published-support-panel published-support-panel-wide">
      <span class="mini-label">Support the show</span>
      <div class="inline-actions published-support-links">
        <% publishedEpisode.supportLinks.forEach((link) => { %>
          <a class="btn btn-secondary" href="<%= link.url %>" target="_blank" rel="noopener noreferrer"><%= link.label %></a>
        <% }) %>
      </div>
    </section>
  <% } %>

  <% if (publishedEpisode.footerNote) { %>
    <section class="published-support-panel published-support-panel-wide">
      <span class="mini-label">From the host</span>
      <p><%= publishedEpisode.footerNote %></p>
    </section>
  <% } %>
</div>
