<section class="published-show-hero">
  <div class="published-show-cover">
    <img src="<%= publishedShow.coverImageUrl %>" alt="<%= publishedShow.name %> cover art" />
  </div>
  <div class="published-show-copy">
    <span class="mini-label">Podcast</span>
    <h1><%= publishedShow.name %></h1>
    <p><%= publishedShow.description %></p>
    <div class="inline-actions published-episode-meta">
      <span class="mini-label"><%= publishedShow.authorName %></span>
      <span class="mini-label"><%= publishedShow.episodeCount %> episodes</span>
      <% if (publishedShow.lastPublishedAt) { %>
        <span class="mini-label">Updated <%= new Date(publishedShow.lastPublishedAt).toLocaleDateString() %></span>
      <% } %>
    </div>
    <div class="inline-actions">
      <a class="btn btn-primary" href="<%= publishedShow.feedUrl %>">RSS Feed</a>
      <a class="btn btn-secondary" href="<%= publishedShow.websiteUrl %>" target="_blank" rel="noopener noreferrer">Website</a>
      <a class="btn btn-ghost" href="<%= publishedShow.embedUrl %>" target="_blank" rel="noopener noreferrer">Embed</a>
    </div>
    <% if ((publishedShow.supportLinks || []).length) { %>
      <div class="inline-actions published-support-links">
        <% publishedShow.supportLinks.forEach((link) => { %>
          <a class="btn btn-secondary" href="<%= link.url %>" target="_blank" rel="noopener noreferrer"><%= link.label %></a>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<section class="published-show-episodes">
  <div class="section-head">
    <h3>Episodes</h3>
    <span class="mini-label"><%= publishedShow.episodes.length %> live</span>
  </div>

  <% if (!publishedShow.episodes.length) { %>
    <p class="empty-state">No public episodes are live yet.</p>
  <% } else { %>
    <div class="published-show-list">
      <% publishedShow.episodes.forEach((episode) => { %>
        <article class="published-show-episode">
          <div>
            <span class="mini-label"><%= episode.publishedAt ? new Date(episode.publishedAt).toLocaleDateString() : 'Published' %></span>
            <h3><a href="<%= episode.episodeUrl %>"><%= episode.title %></a></h3>
            <p><%= episode.summary %></p>
            <div class="inline-actions published-episode-meta">
              <% if (episode.durationLabel) { %>
                <span class="mini-label"><%= episode.durationLabel %></span>
              <% } %>
              <span class="mini-label"><%= episode.explicit ? 'Explicit' : 'Clean' %></span>
              <% if (episode.visibility !== 'public') { %>
                <span class="mini-label">Premium</span>
              <% } %>
            </div>
            <% if ((episode.supportLinks || []).length) { %>
              <div class="inline-actions published-support-links">
                <% episode.supportLinks.forEach((link) => { %>
                  <a class="btn btn-ghost" href="<%= link.url %>" target="_blank" rel="noopener noreferrer"><%= link.label %></a>
                <% }) %>
              </div>
            <% } %>
          </div>
          <audio controls preload="none" src="<%= episode.audioUrl %>"></audio>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>
