<%
  const billingPlanLabels = typeof planLabels !== 'undefined'
    ? planLabels
    : { free: 'Free', creator: 'Creator', growth: 'Growth', studio: 'Studio', pro: 'Creator', premium: 'Growth' };
  const billingStatus = String(billing?.planStatus || 'canceled').toLowerCase();
  const billingStatusLabel = billing?.planStatusLabel || billingStatus.replace(/_/g, ' ');
  const billingStatusClass = billing?.statusBadgeClass || (
    billingStatus === 'active' || billingStatus === 'trialing'
      ? 'badge-ready'
      : (billingStatus === 'past_due' || billingStatus === 'unpaid' ? 'badge-draft' : 'badge-served')
  );
  const paidActive = Boolean(billing?.isPaidActive) || ((billingStatus === 'active' || billingStatus === 'trialing') && billing?.effectivePlan !== 'free');
  const currentPlanKey = billing?.effectiveWorkspacePlan || billing?.effectivePlan || 'free';
  const currentPlanLabel = billingPlanLabels[currentPlanKey] || currentPlanKey;
  const currentHostingPlanKey = billing?.usage?.effectiveHostingPlan || billing?.includedHostingPlan || 'none';
  const currentHostingPlanLabel = billingPlanLabels[currentHostingPlanKey] || currentHostingPlanKey;
  const activeServiceLabel = currentPlanKey !== 'free'
    ? currentPlanLabel + ' workspace'
    : currentHostingPlanLabel + ' hosting';
  const billingHasPaymentIssue = ['payment_failed', 'payment_action_required'].includes(String(billing?.billingAttentionReason || ''));
  const paymentGraceLabel = billing?.workspacePaymentGraceUntilLabel || billing?.hostingPaymentGraceUntilLabel;
  const billingHeroTitle = paidActive
    ? billingHasPaymentIssue
      ? 'Update billing to avoid interruption'
      : activeServiceLabel + ' is live'
    : billingStatus === 'past_due'
      ? 'Get the studio back in rhythm'
      : currentPlanKey === 'free'
        ? 'Choose how VicPods should work for you'
        : currentPlanLabel + ' access is syncing';
  const billingHeroBody = paidActive
    ? billingHasPaymentIssue
      ? 'Stripe will retry the payment automatically. Your current access remains available during the recovery window.'
      : 'Your workspace cycle is active. Hosting capacity is tracked separately so creators pay for production tools and podcast infrastructure in a clean way.'
    : billingStatus === 'past_due'
      ? 'Stripe needs fresh payment details. Update billing to restore paid access and keep your shows, exports, and planning flow intact.'
      : currentPlanKey === 'free'
        ? 'Start with planning for free, then add Workspace and Hosting when you are ready to publish consistently.'
        : 'Stripe checkout completed. VicPods is waiting for the final subscription sync before showing every paid tool as active.';
  const workspacePlans = pricing?.workspacePlans || [];
  const hostingPlans = pricing?.hostingPlans || [];
  const workspacePriority = { free: 0, creator: 1, growth: 2, studio: 3 };
  const hostingPriority = { none: 0, starter: 1, growth: 2, studio: 3 };
  const includedHostingPlanKey = billing?.usage?.includedHostingPlan || billing?.includedHostingPlan || 'none';
  const minimumHostingUpgradePriority = Math.max(
    hostingPriority[includedHostingPlanKey] || 0,
    hostingPriority[currentHostingPlanKey] || 0
  );
  const planAccents = { free: 'blue', creator: 'green', growth: 'pink', studio: 'blue', none: 'blue', starter: 'green' };
  const workspacePlanEyebrows = {
    free: 'Planning only',
    creator: 'Weekly creator',
    growth: 'Business show',
    studio: 'Team room',
  };
  const hostingPlanEyebrows = {
    none: 'No hosting',
    starter: 'One show',
    growth: 'Multi-show',
    studio: 'Network',
  };
  const metricLabel = (value, suffix) => value === null || typeof value === 'undefined'
    ? '0'
    : (value === Infinity ? 'Unlimited' : String(value) + (suffix || ''));
%>

<section class="billing-upgrade-shell">
  <div class="billing-upgrade-hero">
    <div class="billing-album-stack" aria-hidden="true">
      <div class="billing-album-art billing-album-art-main">
        <span class="billing-album-ring"></span>
        <span class="billing-album-mark">VP</span>
      </div>
      <div class="billing-mini-player">
        <span class="billing-play-dot"></span>
        <span class="billing-player-lines"><i></i><i></i></span>
        <span class="billing-eq"><i></i><i></i><i></i><i></i></span>
      </div>
    </div>

    <div class="billing-upgrade-copy">
      <span class="mini-label studio-hero-kicker">Billing Studio</span>
      <h3><%= billingHeroTitle %></h3>
      <p><%= billingHeroBody %></p>
      <div class="billing-chip-row">
        <span class="badge <%= billingStatusClass %>"><%= billingStatusLabel %></span>
        <span class="mini-label"><%= currentPlanLabel %> workspace</span>
        <span class="mini-label"><%= currentHostingPlanLabel %> hosting</span>
        <% if (billing?.currentPeriodEndLabel && paidActive) { %>
          <span class="mini-label">through <%= billing.currentPeriodEndLabel %></span>
        <% } %>
        <% if (billing?.storedPlan && billing.storedPlan !== currentPlanKey) { %>
          <span class="mini-label">stored: <%= billingPlanLabels[billing.storedPlan] || billing.storedPlan %></span>
        <% } %>
      </div>
      <% if (billing?.cancelAtPeriodEnd && billing?.currentPeriodEndLabel) { %>
        <p class="flash flash-error">Your plan will end on <%= billing.currentPeriodEndLabel %> unless renewed.</p>
      <% } %>
      <% if (billingHasPaymentIssue) { %>
        <p class="flash flash-error">
          Payment needs attention. Stripe will retry automatically.
          <% if (billing?.billingNextPaymentAttemptAtLabel) { %>
            Next attempt: <%= billing.billingNextPaymentAttemptAtLabel %>.
          <% } %>
          <% if (paymentGraceLabel) { %>
            Update billing before <%= paymentGraceLabel %> to avoid losing paid access.
          <% } %>
        </p>
      <% } else if (billingStatus === 'past_due') { %>
        <p class="flash flash-error">Payment is past due. Update billing details to restore paid access.</p>
      <% } %>
      <div class="inline-actions studio-hero-actions">
        <form method="POST" action="/billing/portal">
          <button class="btn btn-secondary" type="submit">Manage Billing</button>
        </form>
        <a href="/studio" class="btn btn-ghost">Open Studio</a>
      </div>
    </div>

    <aside class="billing-now-panel">
      <span class="billing-panel-label">Current mix</span>
      <h4><%= currentPlanLabel %></h4>
      <p><%= paidActive ? 'Workspace tools are active. Hosting capacity is measured against the plan below.' : 'Pick a workspace plan when the workflow starts saving real time.' %></p>
      <div class="studio-readiness-meter" aria-hidden="true"><span style="width: <%= currentPlanKey === 'studio' ? 100 : (currentPlanKey === 'growth' ? 76 : (currentPlanKey === 'creator' ? 52 : 28)) %>%"></span></div>
      <div class="studio-now-meta">
        <span><%= billingStatusLabel %></span>
        <span><%= billing?.workspaceCurrentPeriodEndLabel || billing?.currentPeriodEndLabel || 'No paid cycle' %></span>
      </div>
    </aside>
  </div>

  <div class="billing-plan-metrics">
    <% (billing?.usage?.metrics || []).slice(0, 4).forEach((metric) => { %>
      <div class="studio-metric-pill">
        <span><%= metric.label %></span>
        <strong><%= metric.used %><%= metric.unit ? ' ' + metric.unit : '' %></strong>
        <small><%= metric.limit === Infinity ? 'Unlimited' : 'of ' + metric.limit + (metric.unit ? ' ' + metric.unit : '') %></small>
      </div>
    <% }) %>
  </div>
</section>

<section class="billing-record-grid">
  <% workspacePlans.forEach((plan) => { %>
    <% const planIsCurrent = currentPlanKey === plan.key && (plan.key === 'free' || paidActive); %>
    <% const planIsSyncing = currentPlanKey === plan.key && !planIsCurrent && plan.key !== 'free'; %>
    <% const workspaceIsLowerOrEqual = (workspacePriority[plan.key] || 0) <= (workspacePriority[currentPlanKey] || 0); %>
    <article class="billing-record-card billing-record-card-<%= planAccents[plan.key] || 'blue' %> <%= planIsCurrent ? 'active-plan premium-plan-card-active' : '' %> <%= plan.key === 'creator' ? 'premium-plan-card-featured' : '' %>">
      <div class="billing-record-art" aria-hidden="true">
        <span class="billing-record-core"></span>
      </div>
      <div class="premium-plan-card-top">
        <div>
          <span class="mini-label"><%= workspacePlanEyebrows[plan.key] || 'Workspace' %></span>
          <h3><%= plan.title %></h3>
        </div>
        <% if (planIsCurrent) { %>
          <span class="badge badge-ready">Current</span>
        <% } else if (planIsSyncing) { %>
          <span class="badge badge-draft">Syncing</span>
        <% } else if (plan.key === 'creator') { %>
          <span class="badge badge-planned">Best value</span>
        <% } else if (plan.key === 'studio') { %>
          <span class="badge badge-served">Elite</span>
        <% } %>
      </div>
      <p class="price premium-price"><%= plan.price %></p>
      <p class="premium-plan-tagline"><%= plan.summary %></p>
      <div class="billing-plan-caps">
        <span><%= metricLabel(plan.limits.aiActionsPerDay, '/day') %></span>
        <span><%= metricLabel(plan.limits.hostedShows, ' shows') %></span>
        <span><%= metricLabel(plan.limits.collaborators, ' seats') %></span>
      </div>
      <ul class="premium-plan-feature-list">
        <% plan.features.forEach((feature) => { %>
          <li>
            <span class="premium-feature-dot" aria-hidden="true"></span>
            <span><%= feature %></span>
          </li>
        <% }) %>
      </ul>
      <% if (plan.key === 'free') { %>
        <button class="btn btn-secondary" disabled><%= currentPlanKey === 'free' ? 'Current Access' : 'Always Available' %></button>
      <% } else if (planIsCurrent) { %>
        <button class="btn btn-secondary" disabled>Current Access</button>
      <% } else if (workspaceIsLowerOrEqual) { %>
        <button class="btn btn-secondary" disabled>Below Current Plan</button>
      <% } else { %>
        <form method="POST" action="/billing/checkout">
          <input type="hidden" name="productType" value="workspace" />
          <input type="hidden" name="plan" value="<%= plan.key %>" />
          <button class="btn btn-primary" type="submit">Upgrade to <%= plan.title %></button>
        </form>
      <% } %>
    </article>
  <% }) %>
</section>

<section class="billing-proof-shell billing-proof-shell-studio">
  <div class="section-head">
    <div>
      <h3>Podcast hosting capacity</h3>
      <p class="mini-note">Workspace plans include matching hosting capacity. Add hosting only when you need capacity above your included tier.</p>
    </div>
    <span class="mini-label">Current: <%= currentHostingPlanLabel %></span>
  </div>
  <div class="billing-record-grid">
    <% hostingPlans.filter((plan) => plan.key !== 'none' && (hostingPriority[plan.key] || 0) > minimumHostingUpgradePriority).forEach((plan) => { %>
      <% const hostingIsCurrent = currentHostingPlanKey === plan.key; %>
      <article class="billing-record-card billing-record-card-<%= planAccents[plan.key] || 'blue' %> <%= hostingIsCurrent ? 'active-plan premium-plan-card-active' : '' %>">
        <div class="premium-plan-card-top">
          <div>
            <span class="mini-label"><%= hostingPlanEyebrows[plan.key] || 'Hosting' %></span>
            <h3><%= plan.title %></h3>
          </div>
          <% if (hostingIsCurrent) { %>
            <span class="badge badge-ready">Current</span>
          <% } %>
        </div>
        <p class="price premium-price"><%= plan.price %></p>
        <p class="premium-plan-tagline"><%= plan.summary %></p>
        <div class="billing-plan-caps">
          <span><%= plan.limits.hostedShows %> shows</span>
          <span><%= plan.limits.storageGb %> GB</span>
          <span><%= plan.limits.uploadHoursPerMonth %> hr/mo</span>
        </div>
        <p class="mini-note"><%= plan.limits.monthlyDownloads.toLocaleString() %> monthly downloads included.</p>
        <% if (hostingIsCurrent) { %>
          <button class="btn btn-secondary" disabled>Current Hosting</button>
        <% } else { %>
          <form method="POST" action="/billing/checkout">
            <input type="hidden" name="productType" value="hosting" />
            <input type="hidden" name="plan" value="<%= plan.key %>" />
            <button class="btn btn-primary" type="submit">Add <%= plan.title %></button>
          </form>
        <% } %>
      </article>
    <% }) %>
    <% if (!hostingPlans.filter((plan) => plan.key !== 'none' && (hostingPriority[plan.key] || 0) > minimumHostingUpgradePriority).length) { %>
      <article class="billing-record-card billing-record-card-blue">
        <div class="premium-plan-card-top">
          <div>
            <span class="mini-label">Included capacity</span>
            <h3>No hosting add-on needed</h3>
          </div>
          <span class="badge badge-ready">Covered</span>
        </div>
        <p class="premium-plan-tagline">Your current workspace or hosting plan already includes the highest hosting capacity available here.</p>
        <button class="btn btn-secondary" disabled>Included</button>
      </article>
    <% } %>
  </div>
</section>

<% if (typeof billingProofSnippets !== 'undefined' && billingProofSnippets?.length) { %>
  <section class="billing-proof-shell billing-proof-shell-studio">
    <div class="section-head">
      <div>
        <h3>Why creators upgrade</h3>
        <p class="mini-note">Concrete workflow proof instead of generic claims.</p>
      </div>
      <a href="/examples" class="btn btn-ghost">Open example library</a>
    </div>
    <%- include('./proof-snippet-grid', { proofSnippets: billingProofSnippets }) %>
  </section>
<% } %>

<% if (typeof featuredExamples !== 'undefined' && featuredExamples?.length) { %>
  <section class="billing-proof-shell billing-proof-shell-studio">
    <div class="section-head">
      <div>
        <h3>Example output inside VicPods</h3>
        <p class="mini-note">Episode directions and Launch Pack previews from the same product surface.</p>
      </div>
    </div>
    <%- include('./example-preview-grid', { examples: featuredExamples, gridClass: 'example-preview-grid-compact' }) %>
  </section>
<% } %>
