<section class="card">
  <div class="section-head">
    <h3><%= t('admin.section.commandCenter', 'Secret Admin Command Center') %></h3>
    <span class="mini-label"><%= t('admin.section.restricted', 'Admin only') %></span>
  </div>
  <p class="mini-note">
    <strong><%= t('admin.meta.pathLabel', 'Dashboard path') %>:</strong>
    <code><%= dashboardPath %></code>
  </p>
  <p class="mini-note">
    <strong><%= t('admin.meta.keyLabel', 'Secret key protection') %>:</strong>
    <%= secretKeyEnabled ? t('admin.meta.enabled', 'Enabled') : t('admin.meta.devFallback', 'Disabled (development fallback)') %>
  </p>
</section>

<section class="card-grid stats-grid">
  <article class="card stat-card">
    <p><%= t('admin.metric.totalUsers', 'Total users') %></p>
    <h3><%= metrics.totalUsers %></h3>
    <span class="mini-note">+<%= metrics.usersLast24h %> / 24h</span>
  </article>
  <article class="card stat-card">
    <p><%= t('admin.metric.subscribers', 'Subscribers (Pro/Premium)') %></p>
    <h3><%= metrics.totalSubscribers %></h3>
    <span class="mini-note"><%= t('admin.metric.activePaid', 'Active paid') %>: <%= metrics.activePaidUsers %></span>
  </article>
  <article class="card stat-card">
    <p><%= t('admin.metric.paymentRisk', 'Payment risk users') %></p>
    <h3><%= metrics.paymentRiskUsers %></h3>
    <span class="mini-note"><%= t('admin.metric.planHealth', 'Past due or unpaid') %></span>
  </article>
  <article class="card stat-card">
    <p><%= t('admin.metric.aiCalls', 'AI calls today') %></p>
    <h3><%= metrics.aiCallsToday %></h3>
    <span class="mini-note"><%= t('admin.metric.aiActive', 'Active AI users today') %>: <%= metrics.aiActiveUsersToday %></span>
  </article>
</section>

<section class="card-grid stats-grid">
  <article class="card stat-card">
    <p>Human page views (24h)</p>
    <h3><%= metrics.pageViews24h %></h3>
    <span class="mini-note">Human visitors / 7d: <%= metrics.uniqueVisitors7d %></span>
  </article>
  <article class="card stat-card">
    <p>Completed signups (7d)</p>
    <h3><%= metrics.signupsCompleted7d %></h3>
    <span class="mini-note">Signup starts / 7d: <%= metrics.signupsStarted7d %></span>
  </article>
  <article class="card stat-card">
    <p>Successful logins (7d)</p>
    <h3><%= metrics.logins7d %></h3>
    <span class="mini-note">Tracked across web, API, and Google auth</span>
  </article>
  <article class="card stat-card">
    <p>Episode previews (7d)</p>
    <h3><%= metrics.publicEpisodePreviews7d %></h3>
    <span class="mini-note">Podcast idea runs / 7d: <%= metrics.publicPodcastIdeas7d %></span>
  </article>
  <article class="card stat-card">
    <p>Preview leads saved (7d)</p>
    <h3><%= metrics.publicPreviewSaves7d %></h3>
    <span class="mini-note">Total lead emails: <%= metrics.totalPreviewLeads %></span>
  </article>
  <article class="card stat-card">
    <p>User feedback</p>
    <h3><%= metrics.feedbackNew %></h3>
    <span class="mini-note">Total: <%= metrics.feedbackTotal %> · Planned: <%= metrics.feedbackPlanned %></span>
  </article>
  <article class="card stat-card">
    <p>Drafts generated (7d)</p>
    <h3><%= metrics.episodeDrafts7d %></h3>
    <span class="mini-note">Episodes created / 7d: <%= metrics.episodesCreated7d %></span>
  </article>
  <article class="card stat-card">
    <p>Checkout starts (7d)</p>
    <h3><%= metrics.checkoutStarts7d %></h3>
    <span class="mini-note">Completed billing returns / 7d: <%= metrics.checkoutCompleted7d %></span>
  </article>
  <article class="card stat-card">
    <p><%= t('admin.metric.newUsers7d', 'New users (7d)') %></p>
    <h3><%= metrics.usersLast7d %></h3>
    <span class="mini-note"><%= t('admin.metric.newUsers30d', 'New users (30d)') %>: <%= metrics.usersLast30d %></span>
  </article>
  <article class="card stat-card">
    <p><%= t('admin.metric.totalSeries', 'Total series') %></p>
    <h3><%= metrics.totalSeries %></h3>
    <span class="mini-note">+<%= metrics.seriesLast7d %> / 7d</span>
  </article>
  <article class="card stat-card">
    <p><%= t('admin.metric.totalEpisodes', 'Total episodes') %></p>
    <h3><%= metrics.totalEpisodes %></h3>
    <span class="mini-note">+<%= metrics.episodesLast7d %> / 7d · +<%= metrics.episodesLast24h %> / 24h</span>
  </article>
  <article class="card stat-card">
    <p><%= t('admin.metric.totalIdeas', 'Pantry ideas') %></p>
    <h3><%= metrics.totalIdeas %></h3>
    <span class="mini-note">+<%= metrics.ideasLast7d %> / 7d</span>
  </article>
</section>

<section class="card admin-traffic-shell">
  <div class="section-head">
    <div>
      <h3>Human traffic trend</h3>
      <p class="mini-note">Bars are grouped in <%= trafficChart.timeZone %> time so you can track actual movement instead of reading raw events.</p>
    </div>
    <span class="mini-label">Last 14 days + last 24 hours</span>
  </div>

  <div class="admin-traffic-summary">
    <article class="card admin-traffic-summary-card">
      <span class="mini-label">Last 24h vs previous 24h</span>
      <strong><%= trafficChart.last24hDelta %></strong>
      <p class="mini-note">Previous 24h page views: <%= trafficChart.previous24hPageViews %></p>
    </article>
    <article class="card admin-traffic-summary-card">
      <span class="mini-label">14-day daily average</span>
      <strong><%= trafficChart.averageDailyPageViews %></strong>
      <p class="mini-note">Human page views per day</p>
    </article>
    <article class="card admin-traffic-summary-card">
      <span class="mini-label">Busiest day</span>
      <strong><%= trafficChart.busiestDay ? trafficChart.busiestDay.pageViews : 0 %></strong>
      <p class="mini-note"><%= trafficChart.busiestDay ? trafficChart.busiestDay.label : 'No data yet' %></p>
    </article>
  </div>

  <div class="admin-chart-grid">
    <article class="card admin-chart-panel">
      <div class="admin-chart-head">
        <div>
          <h4>Daily page views</h4>
          <p class="mini-note">Human traffic only</p>
        </div>
        <span class="mini-label">14 days</span>
      </div>
      <div class="admin-bar-chart">
        <% trafficChart.dailyPageViews.forEach((point) => { %>
          <div class="admin-bar-chart-column">
            <div class="admin-bar-chart-track" title="<%= `${point.fullLabel}: ${point.value} page views` %>">
              <span class="admin-bar-chart-bar <%= point.isToday ? 'is-today' : '' %>" style="height: <%= point.height %>%"></span>
            </div>
            <span class="admin-bar-chart-value"><%= point.value %></span>
            <span class="admin-bar-chart-label"><%= point.label %></span>
          </div>
        <% }) %>
      </div>
    </article>

    <article class="card admin-chart-panel">
      <div class="admin-chart-head">
        <div>
          <h4>Daily unique visitors</h4>
          <p class="mini-note">Visitors seen through page views</p>
        </div>
        <span class="mini-label">14 days</span>
      </div>
      <div class="admin-bar-chart admin-bar-chart-visitors">
        <% trafficChart.dailyVisitors.forEach((point) => { %>
          <div class="admin-bar-chart-column">
            <div class="admin-bar-chart-track" title="<%= `${point.fullLabel}: ${point.value} visitors` %>">
              <span class="admin-bar-chart-bar admin-bar-chart-bar-alt <%= point.isToday ? 'is-today' : '' %>" style="height: <%= point.height %>%"></span>
            </div>
            <span class="admin-bar-chart-value"><%= point.value %></span>
            <span class="admin-bar-chart-label"><%= point.label %></span>
          </div>
        <% }) %>
      </div>
    </article>
  </div>

  <article class="card admin-chart-panel admin-chart-panel-wide">
    <div class="admin-chart-head">
      <div>
        <h4>Hourly page views</h4>
        <p class="mini-note">Rolling last 24 hours</p>
      </div>
      <span class="mini-label">24 hours</span>
    </div>
    <div class="admin-hour-chart">
      <% trafficChart.hourlyPageViews.forEach((point) => { %>
        <div class="admin-hour-chart-column">
          <div class="admin-hour-chart-track" title="<%= `${point.fullLabel}: ${point.value} page views` %>">
            <span class="admin-hour-chart-bar" style="height: <%= point.height %>%"></span>
          </div>
          <span class="admin-hour-chart-label"><%= point.label %></span>
        </div>
      <% }) %>
    </div>
  </article>
</section>

<section class="card admin-seo-panel">
  <div class="section-head">
    <div>
      <h3>SEO content report</h3>
      <p class="mini-note">30-day performance for indexed public pages and guides. Organic views are based on search-engine referrers. Signup metrics are tied to the landing page cookie captured before registration.</p>
    </div>
    <span class="mini-label">Search + signup view</span>
  </div>

  <% if (!seoContentReport.length) { %>
    <p class="empty-state">No SEO content activity recorded yet.</p>
  <% } else { %>
    <div class="admin-seo-table">
      <% seoContentReport.forEach((item) => { %>
        <div class="admin-seo-row">
          <div>
            <h4><%= item.label %></h4>
            <p class="mini-note"><%= item.path %></p>
          </div>
          <div class="admin-seo-metric">
            <strong><%= item.pageViews %></strong>
            <span>All views</span>
          </div>
          <div class="admin-seo-metric">
            <strong><%= item.organicViews %></strong>
            <span>Search views</span>
          </div>
          <div class="admin-seo-metric">
            <strong><%= item.signupStarts %> / <%= item.signupCompleted %></strong>
            <span>Starts / completed</span>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="card-grid stats-grid">
  <article class="card stat-card">
    <p>Creator partners</p>
    <h3><%= metrics.creatorPartnersTotal %></h3>
    <span class="mini-note">Active pipeline: <%= metrics.creatorPartnersActivePipeline %></span>
  </article>
  <article class="card stat-card">
    <p>Creator posts / approvals</p>
    <h3><%= metrics.creatorPartnersPosted %></h3>
    <span class="mini-note">Ready to push audience traffic</span>
  </article>
  <article class="card stat-card">
    <p>Creator-attributed signups</p>
    <h3><%= metrics.creatorPartnerSignups %></h3>
    <span class="mini-note">Paid conversions: <%= metrics.creatorPartnerPaid %></span>
  </article>
</section>

<section class="card creator-admin-shell tester-admin-shell">
  <div class="section-head">
    <h3>Tester trials</h3>
    <span class="mini-label">No-card volunteer access</span>
  </div>
  <div class="creator-admin-intro">
    <p class="mini-note">Use this for Facebook group volunteers and early testers. Create one trial link, send it to testers, and VicPods grants the selected plan automatically after signup and email verification.</p>
  </div>

  <form method="POST" action="<%= `${dashboardPath}/tester-trials${adminKey ? `?key=${encodeURIComponent(adminKey)}` : ''}` %>" class="creator-admin-form">
    <div class="creator-admin-form-grid">
      <label>
        Trial name
        <input type="text" name="name" maxlength="100" required placeholder="Facebook podcaster testers" />
      </label>
      <label>
        Plan
        <select name="plan">
          <% testerTrialPlans.forEach((plan) => { %>
            <option value="<%= plan %>" <%= plan === 'premium' ? 'selected' : '' %>><%= plan.charAt(0).toUpperCase() + plan.slice(1) %></option>
          <% }) %>
        </select>
      </label>
      <label>
        Trial days
        <input type="number" name="durationDays" min="1" max="90" step="1" value="<%= testerDefaultTrialDays %>" />
      </label>
      <label>
        Max redemptions
        <input type="number" name="maxRedemptions" min="0" step="1" placeholder="0 = unlimited" />
      </label>
      <label>
        Link expires
        <input type="date" name="expiresAt" />
      </label>
      <label class="creator-admin-form-span">
        Notes
        <textarea name="notes" rows="2" maxlength="1200" placeholder="Where this link is shared and what feedback you expect."></textarea>
      </label>
    </div>
    <div class="inline-actions">
      <button type="submit" class="btn btn-primary">Create Trial Link</button>
    </div>
  </form>

  <% if (!testerTrialInvites.length) { %>
    <p class="empty-state">No tester trial links yet. Create one before replying to volunteers.</p>
  <% } else { %>
    <div class="creator-admin-list">
      <% testerTrialInvites.forEach((invite) => { %>
        <article class="card creator-admin-card">
          <div class="creator-admin-card-head">
            <div>
              <h4><%= invite.name %></h4>
              <p>
                <%= invite.plan.charAt(0).toUpperCase() + invite.plan.slice(1) %>
                · <%= invite.durationDays %> days
                · <%= invite.active ? 'active' : 'paused' %>
              </p>
              <% if (invite.notes) { %>
                <p class="mini-note"><%= invite.notes %></p>
              <% } %>
            </div>
            <div class="inline-actions admin-signup-meta">
              <span class="mini-label"><%= invite.statusLabel %></span>
              <% if (invite.expiresAt) { %>
                <span class="mini-label">expires <%= new Date(invite.expiresAt).toLocaleDateString() %></span>
              <% } %>
            </div>
          </div>

          <div class="creator-admin-metrics">
            <article>
              <span class="mini-label">Trial code</span>
              <strong><%= invite.code %></strong>
            </article>
            <article>
              <span class="mini-label">Redeemed</span>
              <strong><%= invite.redeemedCount || 0 %></strong>
            </article>
            <article>
              <span class="mini-label">Limit</span>
              <strong><%= invite.maxRedemptions ? invite.maxRedemptions : 'Open' %></strong>
            </article>
            <article>
              <span class="mini-label">Remaining</span>
              <strong><%= invite.remainingRedemptions === null ? 'Open' : invite.remainingRedemptions %></strong>
            </article>
            <article>
              <span class="mini-label">Invite emails</span>
              <strong><%= invite.inviteEmailSentCount || 0 %></strong>
            </article>
          </div>

          <div class="creator-admin-link-row">
            <input
              type="text"
              value="<%= invite.inviteUrl %>"
              readonly
              data-copy-source="tester-trial-link-<%= invite._id %>"
            />
            <button
              type="button"
              class="btn btn-secondary"
              data-copy-trigger="tester-trial-link-<%= invite._id %>"
              data-copy-label="Copy Trial Link"
            >Copy Link</button>
          </div>

          <form method="POST" action="<%= `${dashboardPath}/tester-trials/${invite._id}/send-email${adminKey ? `?key=${encodeURIComponent(adminKey)}` : ''}` %>" class="creator-admin-update-form">
            <div class="creator-admin-form-grid">
              <label>
                Volunteer email
                <input type="email" name="email" maxlength="255" required placeholder="tester@example.com" />
              </label>
              <label>
                First name optional
                <input type="text" name="name" maxlength="80" placeholder="Sarah" />
              </label>
            </div>
            <div class="inline-actions">
              <button type="submit" class="btn btn-primary" <%= invite.isRedeemable ? '' : 'disabled' %>>
                Send Invite Email
              </button>
              <% if (invite.lastInviteEmailSentAt) { %>
                <span class="mini-note">Last sent to <%= invite.lastInviteEmailSentTo || 'a tester' %> on <%= new Date(invite.lastInviteEmailSentAt).toLocaleDateString() %></span>
              <% } %>
            </div>
          </form>

          <form method="POST" action="<%= `${dashboardPath}/tester-trials/${invite._id}/toggle${adminKey ? `?key=${encodeURIComponent(adminKey)}` : ''}` %>">
            <button type="submit" class="btn btn-ghost">
              <%= invite.active ? 'Pause Link' : 'Reactivate Link' %>
            </button>
          </form>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="card creator-admin-shell">
  <div class="section-head">
    <h3>Creator partnerships</h3>
    <span class="mini-label">Outreach + creator links</span>
  </div>
  <div class="creator-admin-intro">
    <p class="mini-note">Use this for TikTok, YouTube, podcast, or newsletter creators you want testing and sharing VicPods. Every creator gets one unique referral link and one place to track relationship status.</p>
  </div>

  <form method="POST" action="<%= `${dashboardPath}/creator-partners${adminKey ? `?key=${encodeURIComponent(adminKey)}` : ''}` %>" class="creator-admin-form">
    <div class="creator-admin-form-grid">
      <label>
        Creator name
        <input type="text" name="name" maxlength="80" required placeholder="e.g. Sarah Johnson" />
      </label>
      <label>
        Contact email
        <input type="email" name="contactEmail" maxlength="255" placeholder="creator@example.com" />
      </label>
      <label>
        Platform
        <input type="text" name="platform" maxlength="40" placeholder="TikTok" />
      </label>
      <label>
        Handle
        <input type="text" name="handle" maxlength="80" placeholder="@creatorname" />
      </label>
      <label>
        Followers
        <input type="number" name="followerCount" min="0" step="1" placeholder="1800" />
      </label>
      <label>
        Status
        <select name="status">
          <% creatorPartnerStatuses.forEach((status) => { %>
            <option value="<%= status %>"><%= String(status).replace(/_/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase()) %></option>
          <% }) %>
        </select>
      </label>
      <label class="creator-admin-form-span">
        Audience niche
        <input type="text" name="audienceNiche" maxlength="160" placeholder="Podcast creators, faith podcast, business podcasters" />
      </label>
      <label class="creator-admin-form-span">
        Notes
        <textarea name="notes" rows="3" maxlength="2400" placeholder="What they said, when you contacted them, what they need to test, what you promised them."></textarea>
      </label>
    </div>
    <div class="inline-actions">
      <label class="check-item">
        <input type="checkbox" name="markContacted" />
        <span>Mark contacted today</span>
      </label>
      <button type="submit" class="btn btn-primary">Add Creator</button>
    </div>
  </form>

  <% if (!creatorPartners.length) { %>
    <p class="empty-state">No creator partnerships yet. Add the first creator here so the outreach pipeline lives inside VicPods.</p>
  <% } else { %>
    <div class="creator-admin-list">
      <% creatorPartners.forEach((partner) => { %>
        <article class="card creator-admin-card">
          <div class="creator-admin-card-head">
            <div>
              <h4><%= partner.name %></h4>
              <p>
                <%= partner.platform || 'Platform pending' %>
                <% if (partner.handle) { %>
                  · <%= partner.handle %>
                <% } %>
                <% if (partner.followerCount) { %>
                  · <%= partner.followerCount.toLocaleString() %> followers
                <% } %>
              </p>
              <% if (partner.contactEmail) { %>
                <p class="mini-note"><%= partner.contactEmail %></p>
              <% } %>
            </div>
            <div class="inline-actions admin-signup-meta">
              <span class="mini-label"><%= partner.statusLabel %></span>
              <% if (partner.audienceNiche) { %>
                <span class="mini-label"><%= partner.audienceNiche %></span>
              <% } %>
            </div>
          </div>

          <div class="creator-admin-metrics">
            <article>
              <span class="mini-label">Creator link</span>
              <strong><%= partner.referralCode %></strong>
            </article>
            <article>
              <span class="mini-label">Attributed signups</span>
              <strong><%= partner.signupCount %></strong>
            </article>
            <article>
              <span class="mini-label">Paid conversions</span>
              <strong><%= partner.paidConversionCount %></strong>
            </article>
            <article>
              <span class="mini-label">Latest signup</span>
              <strong><%= partner.latestSignupAt ? new Date(partner.latestSignupAt).toLocaleDateString() : 'None yet' %></strong>
            </article>
          </div>

          <div class="creator-admin-link-row">
            <input
              type="text"
              value="<%= partner.inviteUrl %>"
              readonly
              data-copy-source="creator-link-<%= partner._id %>"
            />
            <button
              type="button"
              class="btn btn-secondary"
              data-copy-trigger="creator-link-<%= partner._id %>"
              data-copy-label="Copy Creator Link"
            >Copy Link</button>
          </div>

          <div class="creator-admin-account-row">
            <% if (partner.hasAssignedUser) { %>
              <p class="mini-note">
                VicPods account linked:
                <strong><%= partner.assignedUser.name || partner.assignedUser.email %></strong>
                · <%= partner.assignedUser.email %>
                · <%= partner.assignedUser.plan %> / <%= partner.assignedUser.planStatus %>
              </p>
            <% } else { %>
              <p class="mini-note">No VicPods account found yet for this email. They need to sign up with <%= partner.contactEmail || 'their creator email' %> first before you can grant Premium access.</p>
            <% } %>
            <% if (partner.premiumAccessGrantedAt) { %>
              <p class="mini-note">
                Premium access granted:
                <strong><%= new Date(partner.premiumAccessGrantedAt).toLocaleDateString() %></strong>
                <% if (partner.premiumAccessExpiresAt) { %>
                  · expires <strong><%= new Date(partner.premiumAccessExpiresAt).toLocaleDateString() %></strong>
                  <% if (partner.premiumAccessActive) { %>
                    · active now
                  <% } %>
                <% } %>
              </p>
            <% } %>
          </div>

          <form method="POST" action="<%= `${dashboardPath}/creator-partners${adminKey ? `?key=${encodeURIComponent(adminKey)}` : ''}` %>" class="creator-admin-update-form">
            <input type="hidden" name="partnerId" value="<%= partner._id %>" />
            <div class="creator-admin-form-grid">
              <label>
                Creator name
                <input type="text" name="name" maxlength="80" required value="<%= partner.name %>" />
              </label>
              <label>
                Contact email
                <input type="email" name="contactEmail" maxlength="255" value="<%= partner.contactEmail || '' %>" />
              </label>
              <label>
                Platform
                <input type="text" name="platform" maxlength="40" value="<%= partner.platform || '' %>" />
              </label>
              <label>
                Handle
                <input type="text" name="handle" maxlength="80" value="<%= partner.handle || '' %>" />
              </label>
              <label>
                Followers
                <input type="number" name="followerCount" min="0" step="1" value="<%= partner.followerCount || 0 %>" />
              </label>
              <label>
                Status
                <select name="status">
                  <% creatorPartnerStatuses.forEach((status) => { %>
                    <option value="<%= status %>" <%= status === partner.status ? 'selected' : '' %>><%= String(status).replace(/_/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase()) %></option>
                  <% }) %>
                </select>
              </label>
              <label class="creator-admin-form-span">
                Audience niche
                <input type="text" name="audienceNiche" maxlength="160" value="<%= partner.audienceNiche || '' %>" />
              </label>
              <label class="creator-admin-form-span">
                Notes
                <textarea name="notes" rows="3" maxlength="2400"><%= partner.notes || '' %></textarea>
              </label>
            </div>
            <div class="inline-actions">
              <label class="check-item">
                <input type="checkbox" name="markContacted" />
                <span>Mark contacted today</span>
              </label>
              <button type="submit" class="btn btn-secondary">Save Creator</button>
            </div>
          </form>

          <form method="POST" action="<%= `${dashboardPath}/creator-partners/${partner._id}/grant-access${adminKey ? `?key=${encodeURIComponent(adminKey)}` : ''}` %>">
            <button type="submit" class="btn btn-primary" <%= !partner.contactEmail ? 'disabled' : '' %>>
              Grant <%= creatorDefaultPremiumDays %>-day Premium
            </button>
          </form>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="card">
  <div class="section-head">
    <h3>Public preview leads</h3>
    <span class="mini-label"><%= metrics.totalPreviewLeads %> saved emails</span>
  </div>
  <% if (!recentPreviewLeads.length) { %>
    <p class="empty-state">No public preview leads captured yet.</p>
  <% } else { %>
    <div class="admin-preview-lead-summary">
      <span class="mini-label">Episode preview leads: <%= breakdown.previewLeads.episode_preview %></span>
      <span class="mini-label">Podcast idea leads: <%= breakdown.previewLeads.podcast_ideas %></span>
      <span class="mini-label">Saved in the last 7 days: <%= metrics.recentPreviewLeads7d %></span>
      <span class="mini-label">Preview exports / 7d: <%= metrics.publicPreviewExports7d %></span>
      <span class="mini-label">Billing views / 7d: <%= metrics.billingViews7d %></span>
    </div>
    <div class="list-stack">
      <% recentPreviewLeads.forEach((lead) => { %>
        <div class="list-item admin-preview-lead-item">
          <div>
            <h4><%= lead.email %></h4>
            <p><%= lead.source === 'podcast_ideas' ? 'Podcast idea generator' : 'Idea to episode preview' %></p>
            <% if (lead.sourceInput) { %>
              <p class="mini-note"><%= lead.sourceInput %></p>
            <% } %>
            <p class="mini-note">
              Saved: <%= lead.lastSavedAt ? new Date(lead.lastSavedAt).toLocaleString() : 'Not recorded' %>
              <% if (lead.lastSentAt) { %>
                · emailed: <%= new Date(lead.lastSentAt).toLocaleString() %>
              <% } %>
            </p>
          </div>
          <div class="inline-actions admin-signup-meta">
            <span class="mini-label"><%= lead.source %></span>
            <span class="mini-label">captures: <%= lead.captureCount || 0 %></span>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="card feedback-admin-shell">
  <div class="section-head">
    <div>
      <h3>User feedback + feature requests</h3>
      <p class="mini-note">Direct product signal from logged-in users. Use this queue to track pain points, requests, bugs, and shipped improvements.</p>
    </div>
    <span class="mini-label"><%= feedbackStats.total %> total</span>
  </div>

  <div class="admin-preview-lead-summary feedback-admin-summary">
    <span class="mini-label">New: <%= feedbackStats.statusBreakdown.new %></span>
    <span class="mini-label">Reviewing: <%= feedbackStats.statusBreakdown.reviewing %></span>
    <span class="mini-label">Planned: <%= feedbackStats.statusBreakdown.planned %></span>
    <span class="mini-label">Shipped: <%= feedbackStats.statusBreakdown.shipped %></span>
    <span class="mini-label">Feature requests: <%= feedbackStats.typeBreakdown.feature_request %></span>
    <span class="mini-label">Bugs: <%= feedbackStats.typeBreakdown.bug %></span>
    <span class="mini-label">High priority: <%= feedbackStats.priorityBreakdown.high %></span>
  </div>

  <% if (!feedbackItems.length) { %>
    <p class="empty-state">No user feedback yet. Logged-in users can submit from the Feedback page.</p>
  <% } else { %>
    <div class="feedback-admin-list">
      <% feedbackItems.forEach((item) => { %>
        <article class="card feedback-admin-card">
          <div class="feedback-admin-card-head">
            <div>
              <div class="feedback-history-meta">
                <span class="mini-label"><%= item.typeLabel %></span>
                <span class="mini-label feedback-status-chip feedback-status-<%= item.status %>"><%= item.statusLabel %></span>
                <span class="mini-label feedback-priority-<%= item.priority %>"><%= item.priorityLabel %> priority</span>
              </div>
              <h4><%= item.title %></h4>
              <p class="mini-note">
                <%= item.actorLabel %>
                <% if (item.userEmail || item.contactEmail) { %>
                  · <%= item.userEmail || item.contactEmail %>
                <% } %>
                · <%= new Date(item.createdAt).toLocaleString() %>
              </p>
            </div>
          </div>

          <p class="feedback-admin-message"><%= item.message %></p>

          <div class="feedback-admin-context">
            <% if (item.pageContext) { %>
              <span class="mini-label">Context: <%= item.pageContext %></span>
            <% } %>
            <% if (item.visitorId) { %>
              <span class="mini-label">Visitor: <%= String(item.visitorId).slice(0, 8) %></span>
            <% } %>
            <span class="mini-label">Source: <%= item.source %></span>
          </div>

          <form method="POST" action="<%= `${dashboardPath}/feedback/${item._id}${adminKey ? `?key=${encodeURIComponent(adminKey)}` : ''}` %>" class="feedback-admin-form">
            <% if (typeof csrfToken !== 'undefined') { %>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <% } %>
            <div class="creator-admin-form-grid">
              <label>
                Status
                <select name="status">
                  <% feedbackStatusOptions.forEach((statusOption) => { %>
                    <option value="<%= statusOption.value %>" <%= statusOption.value === item.status ? 'selected' : '' %>><%= statusOption.label %></option>
                  <% }) %>
                </select>
              </label>
              <label>
                Priority
                <select name="priority">
                  <% feedbackPriorityOptions.forEach((priorityOption) => { %>
                    <option value="<%= priorityOption.value %>" <%= priorityOption.value === item.priority ? 'selected' : '' %>><%= priorityOption.label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="creator-admin-form-span">
                Admin note
                <textarea name="adminNote" rows="2" maxlength="1600" placeholder="Decision, follow-up, or roadmap note."><%= item.adminNote || '' %></textarea>
              </label>
            </div>
            <div class="inline-actions">
              <button type="submit" class="btn btn-secondary">Save feedback status</button>
              <% if (item.reviewedAt) { %>
                <span class="mini-note">Last reviewed <%= new Date(item.reviewedAt).toLocaleString() %></span>
              <% } %>
            </div>
          </form>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="card">
  <div class="section-head">
    <h3>Recent human activity</h3>
    <span class="mini-label">Filtered for real visitors</span>
  </div>
  <% if (!recentActivityEvents.length) { %>
    <p class="empty-state">No visitor activity recorded yet.</p>
  <% } else { %>
    <div class="list-stack">
      <% recentActivityEvents.forEach((event) => { %>
        <% const eventLabel = String(event.eventType || '').replace(/_/g, ' '); %>
        <% const actorLabel = event.userEmail || (event.visitorId ? `Visitor ${String(event.visitorId).slice(0, 8)}` : 'Anonymous visitor'); %>
        <div class="list-item">
          <div>
            <h4><%= actorLabel %></h4>
            <p><%= event.requestPath %> · <%= event.authProvider === 'unknown' ? 'visitor' : event.authProvider %></p>
            <p class="mini-note">
              <%= new Date(event.createdAt).toLocaleString() %>
              <% if (event.statusCode) { %>
                · status <%= event.statusCode %>
              <% } %>
            </p>
          </div>
          <span class="mini-label"><%= eventLabel %></span>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="card-grid stats-grid">
  <article class="card stat-card">
    <p>Admin link hits (24h)</p>
    <h3><%= metrics.adminAccessAttempts24h %></h3>
    <span class="mini-note">Unique IPs / 7d: <%= metrics.uniqueAdminIps7d %></span>
  </article>
  <article class="card stat-card">
    <p>Blocked admin attempts (7d)</p>
    <h3><%= metrics.blockedAdminAttempts7d %></h3>
    <span class="mini-note">Guest, unverified, wrong role, wrong key, or invalid config</span>
  </article>
</section>

<section class="split-grid">
  <article class="card">
    <div class="section-head">
      <h3><%= t('admin.section.planBreakdown', 'Plan breakdown') %></h3>
    </div>
    <div class="list-stack">
      <div class="list-item">
        <div>
          <h4>Free</h4>
        </div>
        <span class="mini-label"><%= breakdown.plans.free %></span>
      </div>
      <div class="list-item">
        <div>
          <h4>Pro</h4>
        </div>
        <span class="mini-label"><%= breakdown.plans.pro %></span>
      </div>
      <div class="list-item">
        <div>
          <h4>Premium</h4>
        </div>
        <span class="mini-label"><%= breakdown.plans.premium %></span>
      </div>
    </div>
  </article>

  <article class="card">
    <div class="section-head">
      <h3><%= t('admin.section.episodeStatus', 'Episode status distribution') %></h3>
